    {
      "parameters": {
        "jsCode": "const existing = $json;\n\nconst webhook = $('Webhook: Edit Competitor').first().json;\nconst body = webhook.body ?? webhook;\n\nfunction normalizeUrl(value) {\n  let url = String(value ?? '').trim();\n\n  // Ignore an unnecessary trailing slash when comparing.\n  if (url.endsWith('/') && url.split('/').length > 3) {\n    url = url.slice(0, -1);\n  }\n\n  return url;\n}\n\nfunction normalizePageUrls(values) {\n  return (Array.isArray(values) ? values : [])\n    .map(normalizeUrl)\n    .filter(Boolean)\n    .sort();\n}\n\nconst submittedName = String(body.name ?? '').trim();\nconst submittedUrl = normalizeUrl(body.url);\nconst submittedPageUrls = normalizePageUrls(body.page_urls);\n\nif (!submittedName) {\n  throw new Error('Competitor name is required.');\n}\n\nif (!submittedUrl) {\n  throw new Error('Competitor URL is required.');\n}\n\nif (\n  submittedPageUrls.length < 1 ||\n  submittedPageUrls.length > 3\n) {\n  throw new Error('page_urls must contain between 1 and 3 URLs.');\n}\n\nconst oldUrl = normalizeUrl(existing.url);\nconst oldPageUrls = normalizePageUrls(existing.page_urls);\n\nconst nameChanged = submittedName !== existing.name;\n\nconst urlsChanged =\n  submittedUrl !== oldUrl ||\n  JSON.stringify(submittedPageUrls) !== JSON.stringify(oldPageUrls);\n\nreturn [\n  {\n    json: {\n      competitor_id: existing.id,\n      business_id: existing.business_id,\n\n      old_name: existing.name,\n      old_url: existing.url,\n      old_page_urls: existing.page_urls,\n\n      name: submittedName,\n      url: submittedUrl,\n      page_urls: submittedPageUrls,\n\n      name_changed: nameChanged,\n      urls_changed: urlsChanged,\n      needs_fresh_baseline: urlsChanged,\n    },\n  },\n];"
      },
