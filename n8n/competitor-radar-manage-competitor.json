        "responseBody": "={{ {\n  success: true,\n  competitor_id: $('Webhook: Edit Competitor').first().json.body.competitor_id,\n  name: $('Webhook: Edit Competitor').first().json.body.name,\n  url: $('Webhook: Edit Competitor').first().json.body.url,\n  page_urls: $('Webhook: Edit Competitor').first().json.body.page_urls,\n  fresh_baseline_started: $('Compare Competitor Changes').first().json.urls_changed\n} }}",
